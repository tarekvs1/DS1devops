
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        PATH = "C:\\Users\\ademk\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
    }

    
stage("Setup") {
    steps {
        bat 'node --version'
        bat 'docker --version'

        bat 'if not exist artifacts mkdir artifacts'

        script {
            def version = bat(
                script: 'git describe --tags --exact-match HEAD',
                returnStdout: true
            ).trim()

            if (!(version ==~ /v\\d+\\.\\d+\\.\\d+/)) {
                error "Invalid version tag. Expected format: vX.Y.Z"
            }

            env.TAG_NAME = version

            echo "Valid version: ${env.TAG_NAME}"
        }
    }
}

        // 3. BUILD
        stage("Build") {
            steps {
                script {
                    if (!fileExists("index.html")) {
                        error "index.html does not exist"
                    }

                    if (!fileExists("style.css")) {
                        error "style.css does not exist"
                    }

                    if (!fileExists("script.js")) {
                        error "script.js does not exist"
                    }

                    if (!fileExists("Dockerfile")) {
                        error "Dockerfile does not exist"
                    }

                    echo "All application files are available"

                    // Parallel JavaScript syntax checks
                    def checks = [:]

                    ["22", "24"].each { version ->
                        checks["Node.js ${version}"] = {
                            bat "docker run --rm -v \"%WORKSPACE%:/app\" -w /app node:${version}-alpine node --check script.js"
                        }
                    }

                    parallel checks

                    echo "Parallel syntax checks completed"

                    // Build versioned Docker image
                    bat "docker build -t taskflow:${env.TAG_NAME} . > artifacts\\build.log 2>&1"

                    echo "Versioned Docker image built successfully"
                }
            }
        }

        // 4. RUN DOCKER
        stage("Run (Docker)") {
            steps {
                bat "docker run -d --name taskflow-${env.BUILD_NUMBER} -p 8082:80 taskflow:${env.TAG_NAME}"

                echo "Versioned TaskFlow container started"
            }
        }

        // 5. SMOKE TEST
        stage("smoke test") {
            steps {
                script {
                    def result = powershell(
                        returnStatus: true,
                        script: '''
                            $url = "http://localhost:8082"
                            $success = $false

                            for ($i = 1; $i -le 10; $i++) {
                                try {
                                    $response = Invoke-WebRequest -Uri $url -UseBasicParsing -TimeoutSec 3

                                    if ($response.StatusCode -eq 200) {
                                        $success = $true
                                        break
                                    }
                                }
                                catch {
                                    Start-Sleep -Seconds 2
                                }
                            }

                            if ($success) {
                                "PASSED - Versioned TaskFlow application is responding correctly" |
                                    Out-File -FilePath "artifacts/smoke-test.txt" -Encoding utf8
                                exit 0
                            }
                            else {
                                "FAILED - Versioned TaskFlow application is not responding" |
                                    Out-File -FilePath "artifacts/smoke-test.txt" -Encoding utf8
                                exit 1
                            }
                        '''
                    )

                    if (result != 0) {
                        error "Smoke Test Failed"
                    }

                    echo "Versioned Smoke Test Passed"
                }
            }
        }

        // 6. ARCHIVE ARTIFACTS
        stage("Archive Artifacts") {
            steps {
                bat "docker save taskflow:${env.TAG_NAME} -o artifacts\\taskflow-${env.TAG_NAME}.tar"

                bat "docker logs taskflow-%BUILD_NUMBER% > artifacts\\docker.log 2>&1"

                echo "Versioned Docker image exported successfully"
            }
        }
    }

    post {
        always {
            script {
                // Save Docker logs
                bat '''
                    docker logs taskflow-%BUILD_NUMBER% > artifacts\\docker.log 2>&1 || echo Container logs unavailable > artifacts\\docker.log
                '''

                // Generate version report
                def report = """
TASKFLOW VERSIONED BUILD REPORT
================================

Job Name: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
Version Tag: ${env.TAG_NAME}
Build Result: ${currentBuild.currentResult}

Artifacts:
- build.log
- smoke-test.txt
- docker.log
- taskflow-${env.TAG_NAME}.tar
- pipeline-report.txt
"""

                writeFile(
                    file: 'artifacts/pipeline-report.txt',
                    text: report
                )

                // Archive all artifacts
                archiveArtifacts(
                    artifacts: 'artifacts/*',
                    fingerprint: true,
                    allowEmptyArchive: true
                )
            }

            // Docker cleanup
            bat 'docker rm -f taskflow-%BUILD_NUMBER% 2>nul || exit /b 0'

            echo "Docker cleanup completed"
            echo "Versioned artifacts archived"
        }

        success {
            echo "VERSIONED BUILD PIPELINE PASSED"
        }

        failure {
            echo "VERSIONED BUILD PIPELINE FAILED"
        }
    }
}
