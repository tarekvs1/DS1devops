
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        PATH = "C:\\Users\\ademk\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
    }

    stages {

        stage("Checkout") {
            steps {
                echo "Source code already checked out in Jenkins configuration"
            }
        }

        stage("Setup") {
            steps {
                bat 'node --version'
                bat 'docker --version'

                bat 'if not exist artifacts mkdir artifacts'
                bat 'echo Build stage not started yet > artifacts\\build.log'
                bat 'echo NOT RUN > artifacts\\smoke-test.txt'

                echo "Environment verification completed"
            }
        }

        stage("Build") {
            steps {
                script {
                    if (!fileExists("index.html")) {
                        error "index.html does not exist"
                    }

                    if (!fileExists("style.css")) {
                        error "style.css does not exist"
                    }

                    if (!fileExists("script.js")) {
                        error "script.js does not exist"
                    }

                    if (!fileExists("Dockerfile")) {
                        error "Dockerfile does not exist"
                    }

                    echo "All application files are available"

                    // Parallel JavaScript syntax checks
                    def checks = [:]

                    ["22", "24"].each { version ->
                        checks["Node.js ${version}"] = {
                            bat "docker run --rm -v \"%WORKSPACE%:/app\" -w /app node:${version}-alpine node --check script.js"
                        }
                    }

                    parallel checks

                    echo "JavaScript syntax checks passed on all Node.js versions"
                }
            }
        }

        stage("Run (Docker)") {
            steps {
                bat 'docker build -t taskflow:%BUILD_NUMBER% . > artifacts\\build.log 2>&1'

                bat 'docker run -d --name taskflow-%BUILD_NUMBER% -p 8082:80 taskflow:%BUILD_NUMBER%'

                echo "TaskFlow Docker container started"
            }
        }

        stage("Smoke Test") {
            steps {
                script {
                    def result = powershell(
                        returnStatus: true,
                        script: '''
                            $url = "http://localhost:8082"
                            $success = $false

                            for ($i = 1; $i -le 10; $i++) {
                                try {
                                    $response = Invoke-WebRequest -Uri $url -UseBasicParsing -TimeoutSec 3

                                    if ($response.StatusCode -eq 200) {
                                        $success = $true
                                        break
                                    }
                                }
                                catch {
                                    Start-Sleep -Seconds 2
                                }
                            }

                            if ($success) {
                                "PASSED - TaskFlow application is responding correctly" |
                                    Out-File -FilePath "artifacts/smoke-test.txt" -Encoding utf8
                                exit 0
                            }
                            else {
                                "FAILED - TaskFlow application is not responding" |
                                    Out-File -FilePath "artifacts/smoke-test.txt" -Encoding utf8
                                exit 1
                            }
                        '''
                    )

                    if (result != 0) {
                        error "Smoke Test Failed"
                    }

                    echo "Smoke Test Passed"
                }
            }
        }

        stage("Archive Artifacts") {
            steps {
                bat 'docker logs taskflow-%BUILD_NUMBER% > artifacts\\docker.log 2>&1'

                echo "Docker logs saved successfully"
            }
        }
    }

    post {
        always {
            script {
                // Save Docker logs even if an earlier stage failed
                bat '''
                    docker logs taskflow-%BUILD_NUMBER% > artifacts\\docker.log 2>&1 || echo Container logs unavailable > artifacts\\docker.log
                '''

                // Generate pipeline report
                def report = """
BUILD AND SMOKE PIPELINE REPORT
================================

Job Name: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
Build Result: ${currentBuild.currentResult}

Pipeline: Build & Smoke
Application: TaskFlow

Artifacts:
- build.log
- smoke-test.txt
- docker.log
- pipeline-report.txt
"""

                writeFile(
                    file: 'artifacts/pipeline-report.txt',
                    text: report
                )

                // Archive artifacts in all cases
                archiveArtifacts(
                    artifacts: 'artifacts/*',
                    fingerprint: true,
                    allowEmptyArchive: true
                )
            }

            // Docker cleanup
            bat 'docker rm -f taskflow-%BUILD_NUMBER% 2>nul || exit /b 0'

            echo "Docker cleanup completed"
            echo "Artifacts archived"
        }

        success {
            echo "BUILD AND SMOKE PIPELINE PASSED"
        }

        failure {
            echo "BUILD AND SMOKE PIPELINE FAILED"
        }
    }
}
